# Dev reverse proxy — ONE hostname, paths split by app:
#   shrestha.localhost:8081/…          → Next.js dev on host (:3000)
#   shrestha.localhost:8081/wp-admin   → WordPress (container :80)
#   shrestha.localhost:8081/graphql    → WordPress GraphQL API
# Same shape on LAN: http://192.168.x.x:8081/wp-admin (no per-device setup).
# Requires /etc/hosts: 127.0.0.1 shrestha.localhost
{
	auto_https off
}

:80 {
	# --- WordPress (Apache/PHP in `wordpress` container) ---
	handle /wp-admin* {
		reverse_proxy wordpress:80
	}
	handle /wp-login.php {
		reverse_proxy wordpress:80
	}
	handle /graphql {
		reverse_proxy wordpress:80
	}
	handle /wp-content/* {
		reverse_proxy wordpress:80
	}
	handle /wp-includes/* {
		reverse_proxy wordpress:80
	}
	handle /wp-json/* {
		reverse_proxy wordpress:80
	}
	handle /wp-cron.php {
		reverse_proxy wordpress:80
	}
	handle /xmlrpc.php {
		respond "Not found" 404
	}

	# --- everything else: Next.js dev server on the host ---
	handle {
		reverse_proxy host.docker.internal:3000
	}
}
