# Production secrets — copy to .env.prod, fill in, never commit.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
MYSQL_ROOT_PASSWORD=generate-a-long-random-string
MYSQL_PASSWORD=generate-another-long-random-string
REVALIDATE_SECRET=generate-a-third-long-random-string
# ^ same value must be reachable by WordPress: it is passed into the
# wordpress container automatically (NEXT_APP_URL + REVALIDATE_SECRET).
